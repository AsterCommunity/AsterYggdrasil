{
  "$schema": "https://raw.githubusercontent.com/AsterCommunity/aster-automation/main/schema.json",
  "version": 1,
  "gate": {
    "name": "PR Gate",
    "commentMarker": "<!-- asteryggdrasil-ci-diagnostics -->",
    "incidentMarkerPrefix": "asteryggdrasil-ci-incident",
    "runningLabel": "CI: Running",
    "passedLabel": "CI: Passed"
  },
  "readiness": {
    "name": "PR Readiness",
    "commentMarker": "<!-- asteryggdrasil-pr-readiness -->",
    "requiredChecks": [
      "codecov/patch"
    ],
    "requireResolvedThreads": true,
    "requireApproval": false,
    "highRiskLabel": "Risk: High"
  },
  "labels": {
    "definitions": {
      "Risk: High": {
        "color": "B60205",
        "description": "Changes a high-risk auth, protocol, texture storage, or deployment boundary"
      },
      "CI: Failure": {
        "color": "D73A4A",
        "description": "Tracks a reproducible default-branch or scheduled CI failure"
      },
      "CI: Running": {
        "color": "FBCA04",
        "description": "A pull request has required CI workflows that have not reached a terminal state"
      },
      "CI: Passed": {
        "color": "0E8A16",
        "description": "All required CI workflows passed for the current pull request head"
      },
      "CI: Infrastructure": {
        "color": "5319E7",
        "description": "CI failure appears to originate from runner or external infrastructure"
      },
      "CI: Flaky": {
        "color": "D4C5F9",
        "description": "The same CI failure fingerprint has recurred across runs"
      }
    },
    "applicability": {
      "CI: Failure": [
        "issue"
      ],
      "CI: Infrastructure": [
        "issue"
      ],
      "CI: Flaky": [
        "issue"
      ],
      "CI: Running": [
        "pull_request"
      ],
      "CI: Passed": [
        "pull_request"
      ]
    },
    "rules": [
      {
        "label": "Rust",
        "paths": [
          "**/*.rs",
          "**/Cargo.toml",
          "**/Cargo.lock",
          "crates/aster_yggdrasil_migration/**",
          "crates/aster_yggdrasil_model/**",
          "crates/aster_yggdrasil_render/**"
        ]
      },
      {
        "label": "TypeScript",
        "paths": [
          "frontend-panel/**",
          "**/*.ts",
          "**/*.tsx",
          "**/*.js",
          "**/*.mjs"
        ]
      },
      {
        "label": "Documentation",
        "paths": [
          "docs/**",
          "developer-docs/**",
          "README.md",
          "README.zh.md",
          "CONTRIBUTING.md",
          "CHANGELOG.md"
        ]
      },
      {
        "label": "Dependencies",
        "paths": [
          "**/Cargo.toml",
          "**/Cargo.lock",
          "**/package.json",
          "**/bun.lock"
        ]
      },
      {
        "label": "Scope: Auth",
        "paths": [
          "src/api/routes/auth/**",
          "src/api/routes/auth/external.rs",
          "src/api/middleware/auth.rs",
          "src/api/middleware/csrf/**",
          "src/services/auth/**",
          "src/services/auth/passkey.rs",
          "src/services/user/invitation.rs",
          "src/services/auth/captcha.rs",
          "src/db/repository/contact_verification_token_repo.rs",
          "crates/aster_yggdrasil_model/src/entities/contact_verification_token.rs",
          "crates/aster_yggdrasil_model/src/types/auth.rs"
        ]
      },
      {
        "label": "Scope: Yggdrasil Protocol",
        "paths": [
          "src/services/yggdrasil/**",
          "src/services/yggdrasil/signature.rs",
          "src/services/yggdrasil/session_forward.rs",
          "src/api/routes/yggdrasil.rs",
          "src/api/routes/yggdrasil/**",
          "src/db/repository/yggdrasil_token_repo.rs",
          "src/db/repository/yggdrasil_session_forward_server_repo.rs",
          "crates/aster_yggdrasil_model/src/entities/yggdrasil_token.rs",
          "crates/aster_yggdrasil_model/src/entities/yggdrasil_session_forward_server.rs",
          "crates/aster_yggdrasil_model/src/types/yggdrasil.rs"
        ]
      },
      {
        "label": "Scope: Profiles",
        "paths": [
          "src/services/user/**",
          "src/api/routes/profiles.rs",
          "src/api/routes/admin/profiles.rs",
          "crates/aster_yggdrasil_model/src/entities/minecraft_profile.rs",
          "crates/aster_yggdrasil_model/src/entities/user_profile.rs",
          "crates/aster_yggdrasil_model/src/entities/user_operator_scope.rs",
          "src/db/repository/minecraft_profile_repo.rs",
          "src/db/repository/user_profile_repo.rs"
        ]
      },
      {
        "label": "Scope: Textures",
        "paths": [
          "src/services/texture/**",
          "src/services/texture/preview.rs",
          "src/api/routes/wardrobe.rs",
          "src/api/routes/texture_preview.rs",
          "src/texture_storage/**",
          "crates/aster_yggdrasil_render/**",
          "crates/aster_yggdrasil_model/src/entities/minecraft_texture.rs",
          "crates/aster_yggdrasil_model/src/entities/minecraft_profile_texture.rs",
          "src/db/repository/minecraft_texture_repo.rs",
          "src/db/repository/minecraft_profile_texture_repo.rs",
          "src/api/dto/textures.rs"
        ]
      },
      {
        "label": "Scope: Texture Library",
        "paths": [
          "src/api/routes/texture_library.rs",
          "src/api/routes/admin/texture_library.rs",
          "src/services/texture/library.rs",
          "src/services/texture/reports.rs",
          "src/services/texture/moderation.rs",
          "src/services/texture/wardrobe.rs",
          "crates/aster_yggdrasil_model/src/entities/minecraft_texture_report.rs",
          "crates/aster_yggdrasil_model/src/entities/minecraft_texture_tag.rs",
          "crates/aster_yggdrasil_model/src/entities/minecraft_texture_tag_binding.rs",
          "src/db/repository/minecraft_texture_report_repo.rs",
          "src/db/repository/minecraft_texture_tag_repo.rs"
        ]
      },
      {
        "label": "Scope: External Auth",
        "paths": [
          "src/services/auth/external/**",
          "src/external_auth/**",
          "src/api/routes/auth/external.rs",
          "src/api/routes/admin/external_auth.rs",
          "crates/aster_yggdrasil_model/src/entities/external_auth_provider.rs",
          "crates/aster_yggdrasil_model/src/entities/external_auth_identity.rs",
          "crates/aster_yggdrasil_model/src/entities/external_auth_login_flow.rs",
          "crates/aster_yggdrasil_model/src/entities/external_auth_email_verification_flow.rs",
          "src/db/repository/external_auth_provider_repo.rs",
          "src/db/repository/external_auth_identity_repo.rs",
          "src/db/repository/external_auth_login_flow_repo.rs",
          "src/db/repository/external_auth_email_verification_flow_repo.rs"
        ]
      },
      {
        "label": "Scope: Admin UI",
        "paths": [
          "frontend-panel/src/pages/admin/**",
          "frontend-panel/src/components/admin/**"
        ]
      },
      {
        "label": "Scope: Runtime",
        "paths": [
          "src/runtime/**",
          "src/services/ops/task/**",
          "src/api/routes/admin/tasks.rs",
          "src/api/routes/health.rs",
          "src/services/ops/health/**",
          "crates/aster_yggdrasil_model/src/entities/background_task.rs",
          "src/db/repository/background_task_repo/**",
          "src/config/operations.rs"
        ]
      },
      {
        "label": "Scope: Config",
        "paths": [
          "src/config/**",
          "src/api/routes/admin/config.rs",
          "src/services/ops/config/**",
          "src/db/repository/system_config_repo.rs",
          "config.example.toml"
        ]
      },
      {
        "label": "Scope: Mail",
        "paths": [
          "src/services/mail/**",
          "src/config/mail.rs",
          "crates/aster_yggdrasil_model/src/entities/mail_outbox.rs"
        ]
      },
      {
        "label": "Scope: Docs",
        "paths": [
          "docs/**",
          "developer-docs/**"
        ]
      },
      {
        "label": "Risk: High",
        "paths": [
          "crates/aster_yggdrasil_migration/**",
          "src/api/routes/auth/**",
          "src/api/middleware/auth.rs",
          "src/api/middleware/csrf/**",
          "src/services/auth/**",
          "src/services/auth/passkey.rs",
          "src/services/user/ban.rs",
          "src/api/routes/yggdrasil.rs",
          "src/api/routes/yggdrasil/**",
          "src/services/yggdrasil/**",
          "src/services/yggdrasil/signature.rs",
          "src/texture_storage/**",
          ".github/workflows/**"
        ]
      }
    ]
  },
  "workflows": [
    {
      "name": "Repository Automation",
      "paths": [
        ".github/workflows/**",
        ".github/aster-automation.json",
        "developer-docs/zh-CN/contributing/github-automation.md"
      ]
    },
    {
      "name": "Rust CI",
      "paths": [
        "**/*.rs",
        "Cargo.toml",
        "Cargo.lock",
        "frontend-panel/package.json",
        "frontend-panel/src/types/api.generated.ts",
        "scripts/coverage-summary.mjs",
        ".github/workflows/rust.yml"
      ]
    },
    {
      "name": "Frontend CI",
      "paths": [
        "frontend-panel/**",
        "scripts/coverage-summary.mjs",
        "scripts/rewrite-frontend-lcov-paths.mjs",
        ".github/workflows/frontend.yml"
      ]
    },
    {
      "name": "E2E",
      "paths": [
        "frontend-panel/**",
        "src/**",
        "crates/**",
        "Cargo.toml",
        "Cargo.lock",
        ".github/workflows/frontend-e2e.yml"
      ]
    },
    {
      "name": "Security Audit",
      "paths": [
        "**/Cargo.toml",
        "**/Cargo.lock",
        ".github/workflows/audit.yml"
      ]
    },
    {
      "name": "Docker Image",
      "paths": [
        "src/**",
        "crates/**",
        "Cargo.toml",
        "Cargo.lock",
        "Dockerfile",
        ".github/workflows/docker-image.yml"
      ]
    },
    {
      "name": "Performance Benchmarks",
      "paths": [
        "src/**",
        "crates/**",
        "Cargo.toml",
        "Cargo.lock",
        ".github/workflows/performance.yml"
      ]
    },
    {
      "name": "Release",
      "paths": [
        "src/**",
        "crates/**",
        "Cargo.toml",
        "Cargo.lock",
        ".github/workflows/rust-release.yml"
      ]
    },
    {
      "name": "Deploy Documentation",
      "paths": [
        "docs/**",
        ".github/workflows/vitepress.yml"
      ]
    }
  ],
  "linkedIssues": {
    "priorityPrefix": "Priority: ",
    "statusPrefix": "Status: ",
    "waitLabel": "Wait For PR",
    "readyLabel": "Status: Ready",
    "inProgressLabel": "Status: In Progress",
    "mergedLabel": "Merged",
    "mergedPullLabelsToRemove": [
      "Status: In Progress",
      "Status: Needs Decision"
    ],
    "trackingPattern": "^Tracking-Issue:\\s*#(\\d+)\\s*$"
  },
  "dashboard": {
    "marker": "<!-- asteryggdrasil-milestone-dashboard -->",
    "title": "Release readiness dashboard",
    "milestones": [
      "v0.1.0-beta.1",
      "Not arranged"
    ]
  },
  "incidents": {
    "failureLabel": "CI: Failure",
    "infrastructureLabel": "CI: Infrastructure",
    "recoverySuccesses": 2,
    "flakyLabel": "CI: Flaky",
    "flakyOccurrences": 3
  },
  "diagnosticHints": [
    {
      "pattern": "openapi|generated|sdk drift|generated files",
      "message": "OpenAPI 或生成 SDK 存在漂移，请运行仓库正式生成流程并审查生成 diff。"
    },
    {
      "pattern": "format|clippy|lint",
      "message": "格式或静态检查失败，请先运行对应的本地 format/lint 命令。"
    },
    {
      "pattern": "postgres|mysql|database|migration",
      "message": "数据库检查失败；若多个后端同时失败，优先检查共享查询、migration 与 fixture 契约。"
    },
    {
      "pattern": "playwright|e2e|browser",
      "message": "用户流程检查失败，请从 Playwright artifact 和首个失败步骤开始定位。"
    },
    {
      "pattern": "docker|runner|disk|network|timeout|rate limit|connection reset",
      "message": "日志包含 runner 或外部基础设施信号，先区分环境故障与代码回归再重跑。"
    }
  ]
}
